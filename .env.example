# Service endpoints and OAuth registration; never use NEXT_PUBLIC_ for credentials.
# Hosted MCP Streamable HTTP endpoint. This is the public https://<mcp-host>/mcp URL,
# not the memory API origin. The OAuth access token audience must equal this exact URL.
# Required token claims: account_id, agent_object_id, signer_session_id, key_id, expected_address.
# Required scopes include mcp:connect and agent:read. Sign in again after this URL changes.
MYSO_AGENTS_MCP_URL=
# Private automation-sidecar bridge used by durable action_worker harness turns.
# These are server-only secrets; the dispatch secret must be high entropy and shared
# only by the automation sidecar and this app deployment. The internal secret must
# match the sidecar's INTERNAL_SYNC_SECRET; the dispatch secret must match its
# AUTOMATION_WORK_DISPATCH_SECRET.
MYSO_AGENTS_AUTOMATION_SIDECAR_URL=
MYSO_AGENTS_AUTOMATION_INTERNAL_SECRET=
MYSO_AGENTS_WORKER_DISPATCH_SECRET=
# Base origin for the PoC identity/oracle API used by the creator-beneficiary transfer flow.
MYSO_POC_ORACLE_URL=
# Hosted web sign-in uses the same MySocial login window as the frontend and messaging app.
# Defaults: https://auth.testnet.mysocial.network and client id mysocial-auth-client-id.
# NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN=
# NEXT_PUBLIC_MYSOCIAL_AUTH_CLIENT_ID=
# NEXT_PUBLIC_MYSO_RPC_URL=https://fullnode.testnet.mysocial.network:443
# NEXT_PUBLIC_GRAPHQL_URL=https://graphql.testnet.mysocial.network/graphql
# Server-side zkLogin prover (POST /prove). Required for Google/Apple sign-in.
# The prover derives the official wallet address. A bare origin is joined with /prove.
# MYSO_ZKLOGIN_PROVER_URL=https://zklogin-testnet.mysocial.network/prove
# ZKLOGIN_PROVER_NETWORK=testnet
# Desktop and the legacy /api/myso/auth/start redirect still use this OAuth issuer.
MYSO_AGENTS_OAUTH_ISSUER=
MYSO_AGENTS_OAUTH_CLIENT_ID=
# Space-separated scopes already approved/registered at the issuer; require mcp:connect agent:read.
# Work execution additionally needs work:read work:write ai:read ai:spend, plus chosen task/room/memory scopes.
# Direct MyData quotes/receipts require mydata:read; automated bounded purchases require mydata:purchase.
# Owner wallet graph checkouts require social:write social:approve payments:read mydata:share.
# Verified beneficiary transfer additionally needs payments:write payments:read social:approve.
MYSO_AGENTS_OAUTH_SCOPES=
# Optional WalletConnect project ID for hosted browser and desktop wallet discovery.
# Browser-injected MySo Wallet Standard wallets work without this setting.
NEXT_PUBLIC_MYSO_WALLETCONNECT_PROJECT_ID=
# Exact browser origin. Electron sets its owned loopback origin for its server.
MYSO_AGENTS_PUBLIC_ORIGIN=
# Hosted: 32 random bytes encoded as canonical base64. Keep in deployment secret storage.
# Desktop: generated per launch unless an owner-managed key is supplied.
# Sessions also bind to the owned origin; reconnect after a new loopback port/restart.
MYSO_AGENTS_SESSION_KEY=
# Corresponding modified source for this exact deployed revision; required for production hosting.
MYSO_AGENTS_SOURCE_URL=
# Owner-supplied packaging identity; releases stay disabled until explicitly configured.
# Optional owner-controlled HTTPS generic update feed; omitted means updates are disabled.
MYSO_AGENTS_UPDATE_FEED=

# Memory API origin for encrypted agent-key custody.
NEXT_PUBLIC_MYSO_MEMORY_URL=
# Public messaging relayer origin used by the client-side room SDK.
NEXT_PUBLIC_MYSO_MESSAGING_RELAYER_URL=
# Salt service origin. zkLogin salt and address live at /zklogin-salt and /zklogin-address.
NEXT_PUBLIC_MYSOCIAL_SALT_URL=https://salt.testnet.mysocial.network

# Hosted sign-in. Rebuild after changing NEXT_PUBLIC_ values if you use `pnpm start`.
NEXT_PUBLIC_MYSOCIAL_AUTH_ORIGIN=https://auth.testnet.mysocial.network
NEXT_PUBLIC_MYSOCIAL_AUTH_CLIENT_ID=0x6983b56dde5f1d7585affd5e96e00dc19ea1da559335cdd620f04c3ea824bfea
NEXT_PUBLIC_MYSO_RPC_URL=https://fullnode.testnet.mysocial.network:443
NEXT_PUBLIC_MYSOCIAL_SALT_URL=https://salt.testnet.mysocial.network
MYSO_ZKLOGIN_PROVER_URL=https://zklogin-testnet.mysocial.network/prove

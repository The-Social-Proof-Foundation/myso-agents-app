MYSO_AGENTS_OAUTH_CLIENT_ID=
MYSO_AGENTS_OAUTH_SCOPES=

NEXT_PUBLIC_MYSO_WALLETCONNECT_PROJECT_ID=

# Must match the browser address exactly, including the port.
MYSO_AGENTS_PUBLIC_ORIGIN=http://localhost:3001
